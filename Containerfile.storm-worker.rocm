FROM docker.io/rocm/pytorch:rocm10.0_ubuntu24.04_py3.12_pytorch_release_2.13.0

WORKDIR /opt/workspace
COPY STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/pyproject.toml /opt/workspace/STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/pyproject.toml
COPY STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/uv.lock /opt/workspace/STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/uv.lock
COPY STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/packages /opt/workspace/STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/packages
COPY RAINSTORM/packages/rainstorm-thesis /opt/workspace/RAINSTORM/packages/rainstorm-thesis
COPY RAINSTORM/packages/rainstorm-supervised /opt/workspace/RAINSTORM/packages/rainstorm-supervised
COPY RAINSTORM/envs/vame_worker_rocm/pyproject.toml /opt/workspace/RAINSTORM/envs/vame_worker_rocm/pyproject.toml
COPY RAINSTORM/envs/vame_worker_rocm/uv.lock /opt/workspace/RAINSTORM/envs/vame_worker_rocm/uv.lock
COPY RAINSTORM/src/rainstorm/__init__.py /opt/workspace/RAINSTORM/src/rainstorm/__init__.py
COPY RAINSTORM/src/rainstorm/models /opt/workspace/RAINSTORM/src/rainstorm/models
COPY RAINSTORM/examples/models/trained_models /opt/workspace/RAINSTORM/examples/models/trained_models
COPY RAINSTORM/examples/models/splits/split_example.h5 /opt/workspace/RAINSTORM/examples/models/splits/split_example.h5

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir uv==0.11.8

WORKDIR /opt/workspace/RAINSTORM/envs/vame_worker_rocm
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_PROJECT_ENVIRONMENT=/opt/venv
RUN uv sync --locked --inexact \
        --no-install-package torch \
        --no-install-package triton \
        --no-install-package rocm \
        --no-install-package rocm-sdk-core \
        --no-install-package rocm-sdk-libraries \
        --no-install-package rocm-sdk-device-gfx1103 \
        --no-install-package amd-torch-device-gfx1103 \
        --no-install-package amd-torch-device-gfx110x \
    && uv python install 3.9 \
    && uv venv --python 3.9 /opt/workspace/RAINSTORM/supervised-runtime \
    && uv pip install --python /opt/workspace/RAINSTORM/supervised-runtime/bin/python \
        /opt/workspace/RAINSTORM/packages/rainstorm-supervised

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/opt/workspace/RAINSTORM/src:/opt/workspace/RAINSTORM/packages/rainstorm-thesis/src:/opt/workspace/STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/packages/storm-studio/src:/opt/workspace/STORM-System-for-Traceable-Orchestration-Reuse-and-Modeling/packages/storm-engine/src \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/workspace/.storm/worker-home \
    STORM_WORKSPACE=/workspace/.storm \
    RAINSTORM_SUPERVISED_PYTHON=/opt/workspace/RAINSTORM/supervised-runtime/bin/python
